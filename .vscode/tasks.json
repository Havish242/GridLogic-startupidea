{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run GridPulse Backend",
			"type": "shell",
			"command": "d:/startup idea/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"uvicorn",
				"server.main:asgi_app",
				"--host",
				"0.0.0.0",
				"--port",
				"8000"
			],
			"isBackground": true
		}
	]
}